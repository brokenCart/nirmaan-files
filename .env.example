# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.dev

# --- Database ---
POSTGRES_DB=nirmaan_files
POSTGRES_USER=nirmaan
POSTGRES_PASSWORD=nirmaan
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# --- Google sign-in ---
# OAuth 2.0 Web client from https://console.cloud.google.com/apis/credentials
# Authorised JS origin: http://localhost:5173
GOOGLE_OAUTH_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# --- Photo storage ---
# Optional. Left empty, development stores photos in backend/media/drive/ and
# production hides the upload control. Setup steps: docs/log-images.md.
DRIVE_ROOT_FOLDER_ID=
# The credentials file as one line of JSON, in single quotes.
DRIVE_CREDENTIALS_JSON=

# --- Frontend ---
# Where the Vite dev proxy forwards /api. This value is for running `npm run
# dev` on the host; under `docker compose up` the frontend service overrides it
# with http://backend:8000, since `localhost` inside that container is the
# container itself. Read by Vite in Node only — never shipped to the browser,
# which calls /api/... on its own origin.
VITE_API_BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Local convenience: accept an unsigned JSON claims blob instead of a real
# Google ID token so login can be tested without OAuth credentials.
# Development only — the production settings module has no such switch.
AUTH_FAKE_GOOGLE_TOKENS=false
